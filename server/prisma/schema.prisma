// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DatabaseType {
  MYSQL
  MARIADB
  POSTGRESQL
  MONGODB
  REDIS
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupFormat {
  COMPRESSED_SQL // .sql.gz  — MySQL, MariaDB, PostgreSQL
  PLAIN_SQL // .sql     — MySQL, MariaDB, PostgreSQL
  CUSTOM // .dump    — PostgreSQL only (pg_dump -Fc)
  DIRECTORY // folder   — PostgreSQL only (pg_dump -Fd, parallel)
  TAR // .tar     — PostgreSQL only (pg_dump -Ft)
}

enum MigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum StorageProvider {
  LOCAL
  S3
  GOOGLE_DRIVE
}

enum NotificationEvent {
  BACKUP_COMPLETED
  BACKUP_FAILED
  MIGRATION_COMPLETED
  MIGRATION_FAILED
  VERIFICATION_FAILED
  RETENTION_CLEANUP
}

enum ScheduleFrequency {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum SyncDirection {
  UNIDIRECTIONAL
  BIDIRECTIONAL
}

enum SyncMode {
  REALTIME
  SCHEDULED
  MANUAL
}

enum ConflictStrategy {
  LAST_WRITE_WINS
  SOURCE_WINS
  TARGET_WINS
  MANUAL_RESOLUTION
}

enum SyncStatus {
  ACTIVE
  PAUSED
  FAILED
  STOPPED
}

enum ChangeOperation {
  INSERT
  UPDATE
  DELETE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String
  passwordHash          String
  isActive              Boolean               @default(true)
  // Security cool-down: logins blocked until this time after a password change
  loginLockedUntil      DateTime?
  // Click-through acceptance of TERMS_OF_SERVICE.md at registration
  termsAcceptedAt       DateTime?
  // When true, password sign-in is rejected — passkey only
  passwordLoginDisabled Boolean               @default(false)
  // Bumped on password change and "revoke all sessions"; access tokens carrying
  // an older value are rejected immediately (no waiting for the 15-min expiry).
  tokenVersion          Int                   @default(0)
  // Platform role. ADMIN manages the SaaS (users, stats, support view) via
  // /api/admin/*; bootstrapped by migration (earliest user) or ADMIN_EMAIL env.
  role                  UserRole              @default(USER)
  // Per-user storage quota in bytes (sum of COMPLETED backups, all providers).
  // Default 1 GB free; null = unlimited (admin-settable via /api/admin).
  storageQuotaBytes     BigInt?               @default(1073741824)
  // Max connections a user may create. Default 5 free; null = unlimited.
  connectionLimit       Int?                  @default(5)
  // Max backup retention a user may configure on schedules, in days.
  // Default 30 free; null = unlimited. Sweeps clamp to this too.
  maxRetentionDays      Int?                  @default(30)
  connections           Connection[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  notificationSettings  NotificationSettings?
  storageSettings       StorageSettings?
  syncConfigurations    SyncConfiguration[]
  credentialAccessLogs  CredentialAccessLog[]
  passkeys              PasskeyCredential[]
  mcpApiKeys            McpApiKey[]
  mcpApprovals          McpApproval[]
  restoreDrills         RestoreDrill[]
  restores              Restore[]
  dataSyncRuns          DataSyncRun[]
  liveSyncs             LiveSync[]
  dbAccesses            DbAccess[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("users")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String?
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String    @default("Passkey")
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("passkey_credentials")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@map("refresh_tokens")
}

model Connection {
  id         String       @id @default(uuid())
  name       String
  type       DatabaseType
  host       String
  port       Int
  username   String
  password   String
  database   String
  sslEnabled Boolean      @default(false)
  sslCa      String?
  sslCert    String?
  sslKey     String?

  // SSH Tunnel
  sshEnabled        Boolean @default(false)
  sshHost           String?
  sshPort           Int?    @default(22)
  sshUsername       String?
  sshPrivateKey     String?
  // Path to a key file on the server filesystem — alternative to storing the
  // PEM in the DB (a stolen DB dump then contains no SSH key material).
  sshPrivateKeyPath String?
  sshPassphrase     String?
  // Pinned SSH host key fingerprint ("SHA256:<base64>"), recorded on the first
  // successful connect and checked on every later one (trust on first use).
  sshHostKey        String?

  connectionTimeout Int? @default(30000)

  // Heartbeat monitoring
  heartbeatEnabled    Boolean               @default(false)
  /// MySQL/MariaDB: compress client↔server traffic for dump/restore (slow or remote links)
  compressTraffic     Boolean               @default(false)
  /// Like termination protection: DbBackup never writes to this database (no restore,
  /// sync or migration into it) and the connection can't be deleted while it is on
  writeProtected      Boolean               @default(false)
  heartbeats          ConnectionHeartbeat[]
  // Watchdog: alert when no completed backup within this many hours (null = off)
  expectedBackupHours Int?

  // Relations
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  backups              Backup[]
  schedules            Schedule[]
  migrationsAsSource   Migration[]           @relation("MigrationSource")
  migrationsAsTarget   Migration[]           @relation("MigrationTarget")
  syncConfigsAsSource  SyncConfiguration[]   @relation("SyncSource")
  syncConfigsAsTarget  SyncConfiguration[]   @relation("SyncTarget")
  credentialAccessLogs CredentialAccessLog[]
  restoresAsTarget     Restore[]             @relation("RestoreTarget")
  dataSyncsAsSource    DataSyncRun[]         @relation("DataSyncSource")
  dataSyncsAsTarget    DataSyncRun[]         @relation("DataSyncTarget")
  liveSyncsAsSource    LiveSync[]            @relation("LiveSyncSource")
  liveSyncsAsTarget    LiveSync[]            @relation("LiveSyncTarget")
  dbAccesses           DbAccess[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("connections")
}

model Backup {
  id             String          @id @default(uuid())
  userId         String
  connectionId   String?
  connection     Connection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  fileName       String
  filePath       String
  fileSize       BigInt          @default(0)
  dbType         DatabaseType
  dbName         String
  status         BackupStatus    @default(PENDING)
  format         BackupFormat    @default(COMPRESSED_SQL)
  isCompressed   Boolean         @default(true)
  snapshotName   String?
  notes          String?
  error          String?
  progress       Int             @default(0)
  /// Live progress while RUNNING: bytes on disk so far, the size expected
  /// from the connection's last completed backup (null = no history), the
  /// current step (DUMPING | VERIFYING | ENCRYPTING | UPLOADING), when the
  /// worker last reported (heartbeat) and when the output last grew.
  bytesWritten   BigInt          @default(0)
  expectedBytes  BigInt?
  stage          String?
  progressAt     DateTime?
  bytesChangedAt DateTime?
  checksum       String?
  verified       Boolean         @default(false)
  verifiedAt     DateTime?
  storageType    StorageProvider @default(LOCAL)
  storageKey     String?
  /// Where the dump ran: TUNNEL | SSH_SERVER
  strategy       String          @default("TUNNEL")
  drills         RestoreDrill[]  @relation("DrillBackup")
  restores       Restore[]       @relation("RestoreBackup")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@map("backups")
}

model ConnectionHeartbeat {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status       String // UP | DOWN
  latencyMs    Int?
  error        String?
  checkedAt    DateTime   @default(now())

  @@index([connectionId, checkedAt])
  @@map("connection_heartbeats")
}

model McpApiKey {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  keyHash          String    @unique
  keyPrefix        String
  scopes           String[]
  // When true, write/admin tools pause for human approval before executing
  approvalRequired Boolean   @default(false)
  // Per-key daily call quota (0/null = unlimited)
  dailyCallLimit   Int? // e.g. 100
  callsToday       Int       @default(0)
  callsResetAt     DateTime? // UTC midnight counter reset
  expiresAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("mcp_api_keys")
}

model RestoreDrill {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupId       String
  backup         Backup    @relation("DrillBackup", fields: [backupId], references: [id], onDelete: Cascade)
  status         String    @default("RUNNING") // RUNNING | PASSED | FAILED
  tablesRestored Int?
  rowsRestored   BigInt?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([userId, startedAt])
  @@map("restore_drills")
}

/// One restore of a backup into a database, with live progress while it runs.
/// Names are copied in at start so the history still reads right after the
/// backup or the connection is deleted.
model Restore {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupId           String?
  backup             Backup?     @relation("RestoreBackup", fields: [backupId], references: [id], onDelete: SetNull)
  targetConnectionId String?
  targetConnection   Connection? @relation("RestoreTarget", fields: [targetConnectionId], references: [id], onDelete: SetNull)
  backupLabel        String
  targetName         String
  targetDatabase     String
  /// The target is the database the backup was taken from (confirmed by the user)
  overwritesSource   Boolean     @default(false)
  /// Where the restore tool runs: TUNNEL | SSH_SERVER
  strategy           String      @default("TUNNEL")
  status             String      @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  /// PREPARING | DOWNLOADING | DECRYPTING | RESTORING
  stage              String?
  /// Bytes of the backup file processed in the current stage, of totalBytes
  bytesRead          BigInt      @default(0)
  totalBytes         BigInt?
  stageStartedAt     DateTime?
  /// Worker heartbeat (every few seconds while running)
  progressAt         DateTime?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([targetConnectionId, status])
  @@map("restores")
}

/// One "compare and copy differences" run between two databases with the same
/// schema (source → target). COMPARE only reports; APPLY also writes the
/// differing rows to the target. Names are copied in at start for history.
model DataSyncRun {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConnectionId String?
  sourceConnection   Connection? @relation("DataSyncSource", fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  targetConnectionId String?
  targetConnection   Connection? @relation("DataSyncTarget", fields: [targetConnectionId], references: [id], onDelete: SetNull)
  sourceName         String
  targetName         String
  sourceDatabase     String
  targetDatabase     String
  mode               String // COMPARE | APPLY
  /// Only these tables (empty = all)
  tables             String[]    @default([])
  /// Chunks checked at the same time, each over its own connections
  parallel           Int         @default(4)
  /// FULL: every row; QUICK: rows changed since `since` (by updatedAt), plus new and deleted rows
  method             String      @default("FULL")
  /// The source server's clock (UTC) when the run started
  sourceTime         DateTime?
  since              DateTime?
  status             String      @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  cancelRequested    Boolean     @default(false)
  currentTable       String?
  tablesDone         Int         @default(0)
  tablesTotal        Int?
  rowsChecked        BigInt      @default(0)
  rowsEstimate       BigInt?
  /// Per-table results (TableReport[])
  results            Json?
  /// Schema differences: additions applied (or, when comparing, to apply) and differences only reported
  schema             Json?
  error              String?
  progressAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  /// Started by a live sync to catch up (null: started by the user)
  liveSyncId         String?
  createdAt          DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([targetConnectionId, status])
  @@map("data_sync_runs")
}

/// Live sync: follows the source's binary log and applies each change to the target as it happens
model LiveSync {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConnectionId String?
  sourceConnection   Connection? @relation("LiveSyncSource", fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  targetConnectionId String?
  targetConnection   Connection? @relation("LiveSyncTarget", fields: [targetConnectionId], references: [id], onDelete: SetNull)
  sourceName         String
  targetName         String
  sourceDatabase     String
  targetDatabase     String
  /// The user wants it running
  enabled            Boolean     @default(true)
  /// STARTING | CATCHING_UP | RUNNING | PAUSED | RECONNECTING | STOPPED | ERROR
  status             String      @default("STARTING")
  /// Replica id this follower uses on the source (unique per source server)
  serverId           Int
  /// Where to continue reading the source's binary log (after the last change applied)
  binlogFile         String?
  binlogPos          BigInt?
  /// The sync run bringing the target up to date before following the log
  catchUpRunId       String?
  /// Source time of the last change applied, and when it was applied
  lastEventAt        DateTime?
  appliedAt          DateTime?
  /// The end of the source's binary log when last checked
  headFile           String?
  headPos            BigInt?
  checkedAt          DateTime?
  inserted           BigInt      @default(0)
  updated            BigInt      @default(0)
  deleted            BigInt      @default(0)
  transactions       BigInt      @default(0)
  /// Things to know (e.g. tables not copied, schema changes seen)
  warnings           String[]    @default([])
  error              String?
  startedAt          DateTime?
  stoppedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, targetConnectionId])
  @@map("live_syncs")
}

model McpApproval {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpKeyId   String
  keyName    String
  tool       String
  args       Json?
  status     String    @default("PENDING") // PENDING | APPROVED | DENIED
  result     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@map("mcp_approvals")
}

model Schedule {
  id             String            @id @default(uuid())
  connectionId   String
  connection     Connection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name           String
  frequency      ScheduleFrequency
  cronExpression String
  isActive       Boolean           @default(true)
  retentionDays  Int               @default(30)
  retentionCount Int?
  /// Where the dump runs: TUNNEL (here, through the SSH tunnel) | SSH_SERVER (on the SSH server)
  strategy       String            @default("TUNNEL")
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("schedules")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model CredentialAccessLog {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String // DECRYPT, TEST, BACKUP, RESTORE, SYNC, MIGRATION, VIEW
  ipAddress    String?
  success      Boolean    @default(true)
  errorMessage String?
  timestamp    DateTime   @default(now())

  @@index([connectionId, timestamp])
  @@index([userId, timestamp])
  @@map("credential_access_logs")
}

model Migration {
  id                 String          @id @default(uuid())
  sourceConnectionId String
  sourceConnection   Connection      @relation("MigrationSource", fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  targetConnectionId String
  targetConnection   Connection      @relation("MigrationTarget", fields: [targetConnectionId], references: [id], onDelete: Cascade)
  status             MigrationStatus @default(PENDING)
  tableCount         Int             @default(0)
  tablesCompleted    Int             @default(0)
  rowsMigrated       BigInt          @default(0)
  currentTable       String?
  progress           Int             @default(0)
  notes              String?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())

  @@map("migrations")
}

model NotificationSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled          Boolean  @default(false)
  emailAddress          String?
  smtpHost              String?
  smtpPort              Int?     @default(587)
  smtpUser              String?
  smtpPass              String?
  smtpSecure            Boolean  @default(false)
  slackEnabled          Boolean  @default(false)
  slackWebhookUrl       String?
  ntfyEnabled           Boolean  @default(false)
  ntfyServerUrl         String? // e.g. https://ntfy.sh (default) or self-hosted
  ntfyTopic             String? // topic to publish to
  telegramEnabled       Boolean  @default(false)
  telegramBotToken      String?
  telegramChatId        String?
  discordEnabled        Boolean  @default(false)
  discordWebhookUrl     String?
  whatsappEnabled       Boolean  @default(false)
  whatsappPhoneNumberId String? // Meta WhatsApp Business phone number ID
  whatsappAccessToken   String? // permanent access token (encrypted)
  whatsappRecipient     String? // your personal WhatsApp number (E.164, e.g. 15551234567)
  notifyOnSuccess       Boolean  @default(false)
  notifyOnFailure       Boolean  @default(true)
  notifyOnRetention     Boolean  @default(false)
  notifyOnLogin         Boolean  @default(true)
  notifyOnStorage       Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("notification_settings")
}

model StorageSettings {
  id                      String          @id @default(uuid())
  userId                  String          @unique
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                StorageProvider @default(LOCAL)
  bucket                  String?
  region                  String?
  accessKeyId             String?
  secretAccessKey         String?
  endpoint                String?
  prefix                  String?
  gdriveClientId          String?
  gdriveClientSecret      String?
  gdriveRefreshToken      String?
  gdriveFolderId          String?
  // At-rest encryption of backup files (AES-256-GCM, passphrase-based)
  backupEncryptionEnabled Boolean         @default(false)
  backupPassphrase        String?
  // Old passphrases (encrypted) so backups encrypted before a rotation stay decryptable
  backupPassphraseHistory Json?
  deleteLocal             Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@map("storage_settings")
}

model SyncConfiguration {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  sourceConnectionId String
  sourceConnection   Connection @relation("SyncSource", fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  targetConnectionId String
  targetConnection   Connection @relation("SyncTarget", fields: [targetConnectionId], references: [id], onDelete: Cascade)

  direction        SyncDirection    @default(UNIDIRECTIONAL)
  mode             SyncMode         @default(MANUAL)
  conflictStrategy ConflictStrategy @default(LAST_WRITE_WINS)

  // Table filtering
  includeTables String[] @default([]) // empty = all tables
  excludeTables String[] @default([])

  // Scheduling
  cronExpression String? // for SCHEDULED mode

  // Performance tuning
  batchSize      Int @default(500)
  parallelTables Int @default(1)

  // State
  isActive Boolean @default(false)

  // Relations
  syncState   SyncState?
  changeLogs  ChangeLog[]
  conflicts   Conflict[]
  syncHistory SyncHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sync_configurations")
}

model SyncState {
  id           String            @id @default(uuid())
  syncConfigId String            @unique
  syncConfig   SyncConfiguration @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)

  status SyncStatus @default(ACTIVE)

  // Checkpoints
  sourceCheckpoint String? // database-specific checkpoint (binlog pos, LSN, timestamp)
  targetCheckpoint String? // for bidirectional sync

  // Timing
  lastSyncAt DateTime?
  nextSyncAt DateTime?

  // Statistics
  totalRowsSynced     BigInt @default(0)
  lastSyncDuration    Int? // milliseconds
  averageSyncDuration Int? // milliseconds

  // Current job
  currentJobId    String?
  currentTable    String?
  currentProgress Int     @default(0)

  // Error tracking
  consecutiveFailures Int       @default(0)
  lastError           String?
  lastErrorAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sync_states")
}

model ChangeLog {
  id           String            @id @default(uuid())
  syncConfigId String
  syncConfig   SyncConfiguration @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)

  tableName        String
  operation        ChangeOperation
  primaryKeyValues Json // { "id": 123, "tenant_id": "abc" }
  changeData       Json? // full row data for INSERT/UPDATE

  timestamp  DateTime @default(now())
  checkpoint String // database-specific position
  origin     String   @default("source") // "source" or "target"

  synchronized   Boolean   @default(false)
  synchronizedAt DateTime?

  @@index([syncConfigId, synchronized, timestamp])
  @@map("change_logs")
}

model Conflict {
  id           String            @id @default(uuid())
  syncConfigId String
  syncConfig   SyncConfiguration @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)

  tableName        String
  primaryKeyValues Json

  sourceData      Json
  targetData      Json
  sourceTimestamp DateTime
  targetTimestamp DateTime

  strategy     ConflictStrategy
  resolution   String? // "source", "target", "manual"
  resolvedData Json?

  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String? // userId for manual resolution

  createdAt DateTime @default(now())

  @@index([syncConfigId, resolved])
  @@map("conflicts")
}

model SyncHistory {
  id           String            @id @default(uuid())
  syncConfigId String
  syncConfig   SyncConfiguration @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)

  status String // COMPLETED, FAILED

  rowsSynced        BigInt @default(0)
  tablesProcessed   Int    @default(0)
  conflictsDetected Int    @default(0)
  conflictsResolved Int    @default(0)

  startedAt   DateTime
  completedAt DateTime
  duration    Int // milliseconds

  error String?

  @@index([syncConfigId, startedAt])
  @@map("sync_history")
}

/// A person's login to a database through DbBackup's gateway. They connect to
/// the gateway with their own user and password; the gateway logs in to the
/// database as a user DbBackup created with only the chosen rights.
model DbAccess {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      Connection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Who it is for, e.g. "Ali (backend)"
  name            String
  /// Login name at the gateway
  username        String            @unique
  /// SHA1(SHA1(password)) and SHA256(SHA256(password)): what the MySQL login methods check against
  hashNative      String
  hashSha2        String
  database        String
  /// Empty: the whole database
  tables          String[]
  privileges      String[]
  maxConnections  Int               @default(5)
  enabled         Boolean           @default(true)
  expiresAt       DateTime?
  /// The database user behind it (created by DbBackup)
  backendUser     String
  backendHost     String
  /// Encrypted
  backendPassword String
  lastUsedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        DbAccessSession[]

  @@index([userId])
  @@map("db_access")
}

model DbAccessSession {
  id            String          @id @default(uuid())
  accessId      String
  access        DbAccess        @relation(fields: [accessId], references: [id], onDelete: Cascade)
  clientIp      String
  /// What the client said it is (DBeaver, DbGate, mysql, ...)
  clientProgram String?
  serverVersion String?
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  queries       Int             @default(0)
  bytesIn       BigInt          @default(0)
  bytesOut      BigInt          @default(0)
  /// Why it ended, when not by the client
  error         String?
  log           DbAccessQuery[]

  @@index([accessId, startedAt])
  @@map("db_access_sessions")
}

model DbAccessQuery {
  id        String          @id @default(uuid())
  sessionId String
  session   DbAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  at        DateTime        @default(now())
  /// QUERY, PREPARE, USE or BLOCKED
  kind      String
  sql       String

  @@index([sessionId, at])
  @@index([at])
  @@map("db_access_queries")
}
