{
  "name": "dbbackup",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w dbbackup-server\" \"npm run dev -w client\"",
    "build": "npm run build -w dbbackup-server && npm run build -w client",
    "test": "npm test -w dbbackup-server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "eslint@10": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array@0.23": {
      "minimatch": "^11.0.3"
    },
    "@typescript-eslint/typescript-estree@8": {
      "minimatch": "^11.0.3"
    }
  }
}
